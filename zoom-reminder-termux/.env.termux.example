# Termux/Android config
TZ=Asia/Jakarta
PORT=3000
PYTHON_BIN=python
KHS_ENABLED=false

# Owner bot. Format: 62xxxxx tanpa @s.whatsapp.net
OWNER_NUMBER=628xxxxxxxxxx

# 9Router local AI (OpenAI-compatible API)
# Untuk Termux di HP yang menjalankan 9Router, localhost biasanya benar.
# Jika 9Router berjalan di PC lain, gunakan IP PC yang dapat dijangkau dari HP.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=AI-WhatsAppBot
NINE_ROUTER_API_KEY=

# Arsip bukti pembayaran UKT
UKT_MONTHS=Januari,Maret,April,Mei,Juni
UKT_DRIVE_ROOT_FOLDER_ID=

# Edlink optional
EDLINK_BEARER=
EDLINK_NOTIFY_JID=

# Google Drive optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_PUBLIC=0

# View-once/story optional
AUTO_VIEW_ONCE_JIDS=
AUTO_VIEW_STORY_JIDS=
DELETED_MESSAGE_DETECTION=true

# Wolvesville optional
WOLVESVILLE_API_KEY=
