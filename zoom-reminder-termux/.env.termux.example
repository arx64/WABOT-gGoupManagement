# Termux/Android config
TZ=Asia/Jakarta
PORT=3000
PYTHON_BIN=python
KHS_ENABLED=false

# Owner bot. Format: 62xxxxx tanpa @s.whatsapp.net
OWNER_NUMBER=628xxxxxxxxxx

# OpenAI optional, kosongkan jika fitur AI tidak dipakai
OPENAI_API_KEY=

# Edlink optional
EDLINK_BEARER=
EDLINK_NOTIFY_JID=

# Google Drive optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_PUBLIC=0

# View-once/story optional
AUTO_VIEW_ONCE_JIDS=
AUTO_VIEW_STORY_JIDS=
DELETED_MESSAGE_DETECTION=true

# Wolvesville optional
WOLVESVILLE_API_KEY=
