# ============================================
# Google Drive OAuth2 Configuration
# ============================================

# 1. Buat project di Google Cloud Console (https://console.cloud.google.com)
# 2. Enable Google Drive API
# 3. Buat OAuth2 credentials (Desktop App type)
# 4. Copy Client ID dan Client Secret ke bawah ini:

GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost

# 5. Jalankan: node auth/generateToken.js
# 6. Copy refresh token yang dihasilkan ke bawah ini:

GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# 7. (Optional) ID Folder Google Drive tempat file akan disimpan
#    Biarkan kosong jika ingin disimpan di root My Drive
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ============================================
# Arsip bukti pembayaran UKT
# ============================================
# Daftar bulan UKT yang dipantau, berlaku untuk setiap tahun.
# Bisa memakai angka (1-12) atau nama bulan dalam bahasa Indonesia.
UKT_MONTHS=Januari,Maret,April,Mei,Juni,Juli,September,Oktober,November,Desember
# Folder root opsional khusus arsip UKT di Google Drive.
# Di dalam folder ini (atau root My Drive) bot membuat UKT Yulia Khairani/<tahun>/<bulan>.
UKT_DRIVE_ROOT_FOLDER_ID=
# Direktori fallback lokal jika Drive gagal: uploads/ukt/<tahun>/<bulan>/

# 8. Buat file bisa diakses publik (1 = ya, 0 = tidak)
DRIVE_PUBLIC=0

# ============================================
# Other Configurations
# ============================================

# ============================================
# 9Router local AI (OpenAI-compatible API)
# ============================================
# Gunakan localhost jika bot berjalan di komputer yang sama dengan 9Router.
# Jika bot berjalan di perangkat/container berbeda, ganti localhost dengan IP host 9Router.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL=AI-WhatsAppBot
# Model cadangan, dipisahkan koma; dipakai otomatis jika model utama tidak tersedia.
NINE_ROUTER_FALLBACK_MODELS=cx/gpt-5.6-luna
# Kosongkan jika 9Router lokal tidak membutuhkan autentikasi.
NINE_ROUTER_API_KEY=

EDLINK_BEARER=your_edlink_token_here
EDLINK_EMAIL=your_edlink_email_here
EDLINK_PASSWORD=your_edlink_password_here
EDLINK_NOTIFY_JID=your_whatsapp_jid_here

# ============================================
# Auto View-Once Configuration
# ============================================
# Nomor yang akan auto-convert view-once messages menjadi file biasa
# Format: Nomor WhatsApp separated by comma (62xxxxx)
# Example: AUTO_VIEW_ONCE_JIDS=6281234567890,6281234567891,6282988223456
# Leave empty or comment to disable
# AUTO_VIEW_ONCE_JIDS=

# ============================================
# Auto View Story Configuration
# ============================================
# Nomor yang akan auto-view/read story-nya secara otomatis
# Format: 
#   - Gunakan * untuk auto view SEMUA story (dari semua nomor)
#   - Atau list nomor specific: 6281234567890,6281234567891
# Example 1: AUTO_VIEW_STORY_JIDS=*                           (view semua story)
# Example 2: AUTO_VIEW_STORY_JIDS=6281234567890,6281234567891 (view story dari nomor tertentu)
# Leave empty or comment to disable
# AUTO_VIEW_STORY_JIDS=

# ============================================
# Deleted Message Detection Configuration
# ============================================
# Fitur deteksi pesan yang dihapus
# Set ke "false" untuk menonaktifkan, biarkan true atau hapus untuk mengaktifkan
# Example: DELETED_MESSAGE_DETECTION=false
# Default: true (aktif)
DELETED_MESSAGE_DETECTION=true

# ============================================
# Owner Configuration
# ============================================
# Nomor WhatsApp pemilik bot (untuk akses perintah /rahasia)
# Format: 62xxxxx (tanpa @s.whatsapp.net)
# Example: OWNER_NUMBER=6281234567890
OWNER_NUMBER=your_number_here

# Tujuan file hasil command /see:
#   chat  = kirim ke chat tempat /see digunakan (default, perilaku lama)
#   owner = kirim ke OWNER_NUMBER
SEE_OUTPUT_TARGET=chat

# ============================================
# Wolvesville API Configuration
# ============================================
# Optional: API key dari https://wolvesville.com/ untuk fitur bot
# terkait data resmi Wolvesville (cari player, clan, role info).
# Jika kosong, command /ww (game Werewolf internal) tetap jalan.
# WOLVESVILLE_API_KEY=your_wolvesville_bot_api_key_here
